{
  "info": {
    "name": "Taller MicroServicios Spring Boot Hexagonal",
    "description": "Coleccion de endpoints para Boomerang y Postman",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. POST /api/auth/login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Admin1234!\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/auth/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "2. GET /api/users",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer "
          }
        ],
        "url": {
          "raw": "http://localhost:8080/api/users",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "users"]
        }
      }
    },
    {
      "name": "3. POST /api/users (Crear Usuario)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer "
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"4a61cacc-1c5f-47c6-b27e-c5900944fef9\",\n  \"name\": \"Carlos Perez\",\n  \"email\": \"carlos.perez99@example.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"MEMBER\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/users",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "users"]
        }
      }
    },
    {
      "name": "4. GET /api/users by Id",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer "
          }
        ],
        "url": {
          "raw": "http://localhost:8080/api/users/00000000-0000-0000-0000-000000000001",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "users", "00000000-0000-0000-0000-000000000001"]
        }
      }
    },
    {
      "name": "5. PUT /api/users by Id (Actualizar)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer "
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Juan Perez Actualizado\",\n  \"email\": \"juan.perez@example.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"MEMBER\",\n  \"status\": \"ACTIVE\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/users/11111111-1111-1111-1111-111111111111",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "users", "11111111-1111-1111-1111-111111111111"]
        }
      }
    },
    {
      "name": "6. DELETE /api/users by Id",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer "
          }
        ],
        "url": {
          "raw": "http://localhost:8080/api/users/22222222-2222-2222-2222-222222222222",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "users", "22222222-2222-2222-2222-222222222222"]
        }
      }
    }
  ]
}
